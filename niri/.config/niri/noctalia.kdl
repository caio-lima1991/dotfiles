layout {

    focus-ring {
        active-color   "#bec9c7"
        inactive-color "#131313"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#bec9c7"
        inactive-color "#131313"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#bec9c7"
        inactive-color "#2f3938"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#bec9c780"
    }
}

recent-windows {
    highlight {
        active-color "#bec9c7"
        urgent-color "#ffb4ab"
    }
}
